# macOS
.DS_Store
__MACOSX/

# Python bytecode
__pycache__/
*.py[cod]

# Python packaging
*.egg-info/
build/
dist/
.venv/
venv/

# Python tooling caches and coverage output
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Editors
.vscode/
.idea/

# Logs & temp
*.log
.env

# Agent workspace (local memory, notes, sample reports)
.workbuddy/

# Runtime state written by the script — `cache/` and `snapshots/` are deliberately
# absent here. They must exist in a fresh clone (the script writes into them), so
# each carries its own .gitignore that excludes its contents while keeping the
# directory itself. Ignoring them from this file would drop the directory too.
# See cache/.gitignore and snapshots/.gitignore.
